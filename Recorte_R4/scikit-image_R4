avor, verifica la ruta de tu archivo en Google Drive\")\n","else:\n","    # Leer la imagen\n","    image = io.imread(image_path)\n","    print(f\"Imagen cargada: {image.shape}\")\n","\n","    # Convertir a escala de grises si es necesario\n","    if len(image.shape) == 3:\n","        image_gray = color.rgb2gray(image)\n","    else:\n","        image_gray = image\n","\n","    # Normalizar valores entre 0 y 1\n","    if image_gray.max() > 1:\n","        image_gray = image_gray / image_gray.max()\n","\n","    # ==================================================\n","    # 1. TRANSFORMADA DE HOUGH CIRCULAR\n","    # ==================================================\n","    print(\"\\n--- Aplicando Transformada de Hough Circular ---\")\n","\n","    # Detectar bordes usando Canny\n","    edges = feature.canny(image_gray, sigma=2.0)\n","\n","    # Definir rangos de radios a buscar (ajusta según tu imagen)\n","    hough_radii = np.arange(10, 100, 2)  # Buscar círculos con radios entre 10 y 50 píxeles\n","\n","    # Aplicar transformada de Hough circular\n","    hough_res = hough_circle(edges, hough_radii)\n","\n","    # Detectar los círculos más prominentes\n","    accums, cx, cy, radii = hough_circle_peaks(hough_res, hough_radii,\n","                                                total_num_peaks=100, # Número máximo de círculos\n","                                                min_xdistance=20,\n","                                                min_ydistance=20)\n","\n","    print(f\"Círculos detectados: {len(cx)}\")\n","\n","    # Visualizar resultados - Imagen Original\n","    plt.figure(figsize=(6, 6))\n","    plt.imshow(image_gray, cmap='gray')\n","    plt.title('Imagen Original')\n","    plt.axis('off')\n","    plt.show()\n","\n","    # Visualizar resultados - Bordes detectados\n","    plt.figure(figsize=(6, 6))\n","    plt.imshow(edges, cmap='gray')\n","    plt.title('Bordes (Canny)')\n","    plt.axis('off')\n","    plt.show()\n","\n","    # Visualizar resultados - Círculos detectados\n","    plt.figure(figsize=(6, 6))\n","    plt.imshow(image_gray, cmap='gray')\n","    for center_y, center_x, radius in zip(cy, cx, radii):\n","        circy, circx = circle_perimeter(center_y, center_x, radius,\n","                                        shape=image_gray.shape)\n","        plt.plot(circx, circy, 'r-', linewidth=2)\n","        plt.plot(center_x, center_y, 'b+', markersize=15, markeredgewidth=2)\n","    plt.title(f'Círculos Detectados ({len(cx)})')\n","    plt.axis('off')\n","    plt.show()\n"]}]}